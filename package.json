{
  "name": "tco-agreement-generator-build",
  "private": true,
  "version": "1.1.2",
  "description": "Build shell for the TCO Agreement Generator desktop app (app source lives in electron/)",
  "devDependencies": {
    "electron": "43.1.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.tco.agreementgenerator",
    "productName": "TCO Agreement Generator",
    "directories": {
      "app": "electron",
      "output": "dist"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "icon": "electron/tco.icns",
      "category": "public.app-category.business"
    }
  }
}
